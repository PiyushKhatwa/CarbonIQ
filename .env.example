# ==============================================================================
# CarbonIQ Environment Configuration Template
# Copy this file to .env and configure local values
# Never commit .env with actual credentials to version control
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=5000
FRONTEND_PORT=5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carboniq_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_carboniq_minimum_32_characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_PROVIDER=gemini # options: gemini, openai, rule_based_fallback
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Client Application
VITE_API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173
