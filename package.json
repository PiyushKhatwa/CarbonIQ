{
  "name": "carboniq-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CarbonIQ — AI-Powered Carbon Emissions Footprint Tracker (ADBMS Academic Project)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "db:migrate": "node database/scripts/migrate.js",
    "db:seed": "node database/scripts/seed.js",
    "db:verify": "node database/scripts/verify.js",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:ai": "python ai-service/app/main.py",
    "test:api": "node tests/backend_api_test.js",
    "test:ai": "python tests/ai_service_test.py",
    "test:db": "node database/scripts/verify.js",
    "test:adbms": "node database/scripts/run_adbms_suite.js",
    "test:concurrency": "node tests/concurrency_test.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.11.3"
  }
}

