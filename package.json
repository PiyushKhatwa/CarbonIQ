{
  "name": "carboniq-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CarbonIQ — AI-Powered Carbon Emissions Footprint Tracker (ADBMS Academic Project)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "db:migrate": "node database/scripts/migrate.js",
    "db:seed": "node database/scripts/seed.js",
    "db:verify": "node database/scripts/verify.js",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "test:db": "node database/scripts/verify.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.11.3"
  }
}
